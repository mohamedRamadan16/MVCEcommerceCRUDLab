@model Order
@{
    ViewData["Title"] = "Order Details";
}

<h2>Order Details - @Model.OrderNumber</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">
                <h5>Order Information</h5>
            </div>
            <div class="card-body">
                <p><strong>Order Number:</strong> @Model.OrderNumber</p>
                <p><strong>Customer:</strong> @Model.User.FullName (@Model.User.Email)</p>
                <p><strong>Order Date:</strong> @Model.OrderDate.ToString("MM/dd/yyyy HH:mm")</p>
                <p><strong>Total Amount:</strong> $@Model.TotalAmount.ToString("N2")</p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">
                <h5>Shipping Address</h5>
            </div>
            <div class="card-body">
                <p>@Model.ShippingAddress.Street</p>
                <p>@Model.ShippingAddress.City, @Model.ShippingAddress.Zip</p>
                <p>@Model.ShippingAddress.Country</p>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5>Update Order Status</h5>
    </div>
    <div class="card-body">
        <form asp-action="UpdateStatus" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.OrderId" />
            <select name="status" class="form-select d-inline w-auto">
                @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                {
                    <option value="@status" selected="@(status == Model.Status)">@status</option>
                }
            </select>
            <button type="submit" class="btn btn-primary">Update Status</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5>Order Items</h5>
    </div>
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <td>@item.Product.Name</td>
                        <td>@item.Product.SKU</td>
                        <td>$@item.UnitPrice.ToString("N2")</td>
                        <td>@item.Quantity</td>
                        <td>$@item.LineTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end"><strong>Total:</strong></td>
                    <td><strong>$@Model.TotalAmount.ToString("N2")</strong></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to Orders</a>
</div>
