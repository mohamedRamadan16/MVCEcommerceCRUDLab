@page
@model ECommerceMVCProject.Areas.Identity.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Logged out";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4 text-center">
        <div class="card">
            <div class="card-body p-4">
                <h4 class="mb-2">You have been logged out</h4>
                <p class="text-muted mb-4">Thanks for visiting. See you next time!</p>
                <a asp-area="" asp-controller="Catalog" asp-action="Index" class="btn btn-dark w-100">Back to Shop</a>
            </div>
        </div>
    </div>
</div>
