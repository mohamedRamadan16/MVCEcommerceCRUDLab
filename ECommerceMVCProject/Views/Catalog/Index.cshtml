@model ProductListVM
@{
    ViewData["Title"] = "Products";
}

<div class="row">
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-header">Categories</div>
            <div class="list-group list-group-flush">
                <a asp-action="Index" asp-route-q="@Model.SearchTerm"
                   class="list-group-item list-group-item-action @(Model.SelectedCategoryId == null ? "active" : "")">
                    All
                </a>
                @foreach (var category in Model.Categories)
                {
                    <a asp-action="Index" asp-route-categoryId="@category.CategoryId" asp-route-q="@Model.SearchTerm"
                       class="list-group-item list-group-item-action @(Model.SelectedCategoryId == category.CategoryId ? "active" : "")">
                        @category.Name
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Products</h4>
            <small class="text-muted">@Model.Products.Count() item(s) found</small>
        </div>

        <form asp-action="Index" method="get" class="mb-4">
            <div class="input-group">
                <input type="text" name="q" value="@Model.SearchTerm" class="form-control" placeholder="Search products..." />
                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                <button class="btn btn-dark" type="submit">Search</button>
            </div>
        </form>

        @if (!Model.Products.Any())
        {
            <div class="alert alert-info">No products found.</div>
        }

        <div class="row row-cols-1 row-cols-md-3 g-3">
            @foreach (var product in Model.Products)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <h6 class="card-title mb-1">@product.Name</h6>
                            <span class="badge bg-secondary mb-2">@product.Category.Name</span>
                            <p class="mb-0">
                                <span class="text-success fw-semibold fs-5">$@product.Price.ToString("N2")</span>
                            </p>
                            <p class="text-muted small mb-0">
                                @(product.StockQuantity > 0 ? $"{product.StockQuantity} in stock" : "Out of stock")
                            </p>
                        </div>
                        <div class="card-footer bg-white d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-sm btn-outline-secondary">Details</a>
                            @if (product.StockQuantity > 0)
                            {
                                <form asp-area="" asp-controller="Cart" asp-action="Add" asp-route-productId="@product.ProductId" method="post">
                                    <button type="submit" class="btn btn-sm btn-dark">Add to Cart</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-secondary" disabled>Out of Stock</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-categoryId="@Model.SelectedCategoryId" asp-route-q="@Model.SearchTerm">Previous</a>
                        </li>
                    }
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i"
                               asp-route-categoryId="@Model.SelectedCategoryId" asp-route-q="@Model.SearchTerm">@i</a>
                        </li>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-categoryId="@Model.SelectedCategoryId" asp-route-q="@Model.SearchTerm">Next</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
