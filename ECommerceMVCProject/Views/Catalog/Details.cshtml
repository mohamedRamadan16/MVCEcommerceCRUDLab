@model ProductDetailsVM
@{
    ViewData["Title"] = Model.Product.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
        <li class="breadcrumb-item active">@Model.Product.Name</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h4 class="mb-1">@Model.Product.Name</h4>
                <span class="badge bg-secondary mb-3">@Model.Product.Category.Name</span>

                <dl class="row mb-3">
                    <dt class="col-sm-4 text-muted">SKU</dt>
                    <dd class="col-sm-8">@Model.Product.SKU</dd>
                    <dt class="col-sm-4 text-muted">Stock</dt>
                    <dd class="col-sm-8">
                        @if (Model.InStock)
                        {
                            <span class="text-success">@Model.Product.StockQuantity available</span>
                        }
                        else
                        {
                            <span class="text-danger">Out of stock</span>
                        }
                    </dd>
                    <dt class="col-sm-4 text-muted">Price</dt>
                    <dd class="col-sm-8">
                        <span class="fs-4 fw-semibold text-success">$@Model.Product.Price.ToString("N2")</span>
                    </dd>
                </dl>

                <div class="d-flex gap-2">
                    @if (Model.InStock)
                    {
                        <form asp-area="" asp-controller="Cart" asp-action="Add" asp-route-productId="@Model.Product.ProductId" method="post">
                            <button type="submit" class="btn btn-dark">Add to Cart</button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary" disabled>Out of Stock</button>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary">← Back</a>
                </div>
            </div>
        </div>
    </div>
</div>

