@model IEnumerable<Address>
@{
    ViewData["Title"] = "My Addresses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Addresses</h2>
    <a asp-action="Create" class="btn btn-primary">Add New Address</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You don't have any saved addresses. <a asp-action="Create">Add one now.</a>
    </div>
}
else
{
    <div class="row">
        @foreach (var address in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card">
                    <div class="card-body">
                        @if (address.IsDefault)
                        {
                            <span class="badge bg-primary mb-2">Default</span>
                        }
                        <p class="mb-1">@address.Street</p>
                        <p class="mb-1">@address.City, @address.Zip</p>
                        <p class="mb-0">@address.Country</p>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@address.AddressId" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@address.AddressId" class="btn btn-sm btn-danger">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
