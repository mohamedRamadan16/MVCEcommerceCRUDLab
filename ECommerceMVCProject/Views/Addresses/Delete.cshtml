@model Address
@{
    ViewData["Title"] = "Delete Address";
}

<h2>Delete Address</h2>

<div class="alert alert-warning">
    <h4>Are you sure you want to delete this address?</h4>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-3">Street</dt>
        <dd class="col-sm-9">@Model.Street</dd>
        
        <dt class="col-sm-3">City</dt>
        <dd class="col-sm-9">@Model.City</dd>
        
        <dt class="col-sm-3">Zip</dt>
        <dd class="col-sm-9">@Model.Zip</dd>
        
        <dt class="col-sm-3">Country</dt>
        <dd class="col-sm-9">@Model.Country</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="AddressId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
